{
  "ConnectionStrings": {
    //"CustDb": "Server=customer-sql,1433;Database=CustDb;User Id=sa;Password=Your_password123;Encrypt=False;TrustServerCertificate=True;"
    "CustDb": "",
    "Redis": "localhost:6379"
  },
  "Caching": {
    // "Memory" (default, no extra infra) or "Redis" (needs the redis service
    // in docker-compose.yml running — see docker-compose up -d redis)
    "Provider": "Redis"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}